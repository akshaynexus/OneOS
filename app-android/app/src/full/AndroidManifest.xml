<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The full edition (com.fahadali.oneos): the switching screens, merged
         into src/main's manifest. The image is picked in the system file
         picker (ACTION_OPEN_DOCUMENT, a read grant for that one file). Every
         change on the phone is a verb of assets/root/oneos_root.sh, run as
         root from a screen the user confirmed. -->
    <!-- 0.4.41: setup (with its downloads) runs in a foreground service, so leaving or
         swiping the app away does not kill it half way; its notification shows the step. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- An import of the iOS image set (about 18 GB) goes on with the screen off; held only while it runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 0.4.45: the app's own update through Android's installer when root is off
         (AppUpdater); the user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Once OneOS installed itself this way, Android lets its later updates skip the prompt. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Bring apps (0.4.75): without this Android hides other apps from us and the
         list showed two of 120 (11-10). Every app with a launcher icon, nothing more. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:name=".ui.OneOsApplication">
        <service
            android:name=".session.PrepareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Holds the app while a OneiOS download or import runs (docs/oneios.md, "Importing either package"). -->
        <service
            android:name=".session.OneiosService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".session.AppUpdater$ResultReceiver"
            android:exported="false" />
        <activity android:name=".ui.GuestRuntimeActivity" android:exported="false" />
        <!-- The iOS 27 (OneiOS) system's screen (docs/oneios.md): runtime, image set, switch. -->
        <activity
            android:name=".ui.OneiosActivity"
            android:exported="false"
            android:label="@string/oneios_title"
            android:parentActivityName=".ui.SystemsActivity" />
        <!-- Hardware checks of the iOS system: OneiOS's phone tools, run as root beside One UI. -->
        <activity
            android:name=".ui.OneiosChecksActivity"
            android:exported="false"
            android:label="@string/oneios_checks"
            android:parentActivityName=".ui.OneiosActivity" />
        <!-- Session logs of the iOS system: xnuhost's, the switch's and the return's, read as root (read only). -->
        <activity
            android:name=".ui.OneiosLogsActivity"
            android:exported="false"
            android:label="@string/oneios_logs"
            android:parentActivityName=".ui.OneiosActivity" />
        <activity
            android:name=".ui.OneiosLogActivity"
            android:exported="false"
            android:label="@string/oneios_logs"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:parentActivityName=".ui.OneiosLogsActivity" />
        <activity android:name=".ui.EnvironmentActivity" android:exported="false" />
        <activity android:name=".ui.BootProgressActivity" android:exported="false" />
        <activity android:name=".ui.DebugSettingsActivity" android:exported="false" />
        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.LauncherActivity" android:exported="false" />

        <!-- Build 2: pick and check the image, prepare the stage, switch, the last session. -->
        <activity
            android:name=".ui.ImageActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PrepareActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SwitchActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.LastSessionActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <activity
            android:name=".ui.OldStagesActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <!-- Bring apps (0.4.75, Advanced): user apps with their data, One UI -> the system set up now. -->
        <activity
            android:name=".ui.BringAppsActivity"
            android:exported="false"
            android:parentActivityName=".ui.AdvancedActivity" />

        <!-- The redesign: Choose a system (Home's "Choose a system", the fixes
             that choose a system or a file) and Setting up (Home's "Show
             progress", and every setup a fix starts). The labels name the
             windows for TalkBack; their bars show no title until scrolled. -->
        <activity
            android:name=".ui.SystemsActivity"
            android:exported="false"
            android:label="@string/systems_title"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SetupProgressActivity"
            android:exported="false"
            android:label="@string/setup_label"
            android:parentActivityName=".ui.MainActivity" />

        <!-- The redesign: Home's Advanced (cards: your system, sessions, help)
             and its one entry For the OneOS team (the technical screens). -->
        <activity
            android:name=".ui.AdvancedActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.TeamActivity"
            android:exported="false"
            android:parentActivityName=".ui.AdvancedActivity" />

        <!-- The still OneOS screen for the black gap of a switch. Not exported:
             oneos_switch.sh starts it as root (am start -n
             com.fahadali.oneos/.ui.GapSplashActivity, ONEOS_SPLASH_COMPONENT)
             and waits for its "Status: ok" before it freezes One UI's
             surfaceflinger on it. -->
        <activity
            android:name=".ui.GapSplashActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OneOS.Handoff" />
    </application>

</manifest>
