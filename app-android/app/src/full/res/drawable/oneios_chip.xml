<?xml version="1.0" encoding="utf-8"?>
<!-- A filter chip of the session log viewer: filled when it is on (activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/preboot_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/preboot_secondary" />
        </shape>
    </item>
</selector>
